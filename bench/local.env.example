# This file is sourced by bash (`bench/run.sh`): anything in it runs with your
# privileges. Keep it to KEY=value lines.
#
# Copy to bench/local.env and fill in. bench/local.env is git-ignored: it is the
# only place machine-specific values live, so nothing user-specific is committed.
#
#   cp bench/local.env.example bench/local.env

# Target simulator UDID. Find one with: xcrun simctl list devices booted
BENCH_UDID=

# Bundle id of the app under test. Apple Settings needs no build:
# com.apple.Preferences
BENCH_APP_BUNDLE_ID=

# agent-device session name. Sessions are always explicit, never implicit.
BENCH_SESSION=default

# Optional. The Settings row bench/flows/settings-observe-act.sh presses. Label
# selectors match exactly, and Settings is localised, so a device that is not in
# English needs its own spelling here. Read it out of `agent-device snapshot -i`.
#   BENCH_SETTINGS_ROW=text=General
